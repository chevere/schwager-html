{
    "name": "chevere/schwager-html",
    "description": "Generates documentation for Schwager API",
    "homepage": "https://chevere.org",
    "type": "library",
    "license": "Apache-2.0",
    "authors": [
        {
            "name": "Rodolfo Berrios",
            "email": "rodolfo@chevere.org",
            "homepage": "https://chevere.org"
        }
    ],
    "require": {
        "php": "^8.1",
        "chevere/action": "^3.0.0",
        "chevere/caller": "^1.0.0",
        "chevere/container": "^1.0.0",
        "chevere/data-structure": "^1.1.1",
        "chevere/http": "^0.8.x-dev",
        "chevere/parameter": "^2.0.0",
        "chevere/router": "^0.10.x-dev",
        "chevere/schwager": "^0.3.x-dev",
        "chevere/standard": "^1.0.1",
        "symfony/yaml": "^6|^7"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^10.5",
        "symplify/easy-coding-standard": "^13.2"
    },
    "autoload": {
        "psr-4": {
            "Chevere\\SchwagerHTML\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Chevere\\Tests\\": "tests/",
            "Chevere\\Demo\\": "demo/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    },
    "scripts": {
        "all": [
            "composer phpstan",
            "composer test",
            "composer test-coverage",
            "composer infection -- --skip-initial-tests --coverage=build/logs"
        ],
        "infection": [
            "Composer\\Config::disableProcessTimeout",
            "infection -j10"
        ],
        "infection-filter": "sh -c 'sh -c \"composer infection -- --filter=$0 --test-framework-options=--filter=$1\"' $1 $2",
        "phpstan": "vendor/bin/phpstan analyze --memory-limit 512M --level 9",
        "test": [
            "Composer\\Config::disableProcessTimeout",
            "vendor/bin/phpunit -c phpunit.xml --no-coverage"
        ],
        "test-coverage": [
            "Composer\\Config::disableProcessTimeout",
            "vendor/bin/phpunit -c phpunit.xml"
        ],
        "cs-update": "mkdir -p .ecs && cd .ecs && curl -O https://raw.githubusercontent.com/chevere/code-style/main/.ecs/ecs-chevere.php",
        "cs-fix": "vendor/bin/ecs --config='.ecs/ecs.php' src --fix",
        "open-coverage": "open build/logs/html/index.html",
        "open-infection": "open build/logs/html/infection.html"
    },
    "scripts-descriptions": {
        "all": "Runs all checks",
        "infection": "Runs infection",
        "infection-filter": "Runs infection filtered (args infection-filter phpunit-filter)",
        "phpstan": "Runs phpstan",
        "test": "Run test suite",
        "test-coverage": "Run test suite (coverage)",
        "cs-update": "Update Chevere code style definition",
        "cs-fix": "Update Chevere code style definition",
        "open-coverage": "Open code coverage report",
        "open-infection": "Open infection report"
    }
}
